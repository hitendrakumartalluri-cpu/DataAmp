AMP_APP_NAME=AMP Enterprise Beta
AMP_VERSION=0.11.0-beta.1
AMP_DATABASE_URL=postgresql://amp:amp_change_me@postgres:5432/amp
AMP_API_KEY=
AMP_DEMO_MODE=true
AMP_DATA_ROOT=/data
AMP_DEFAULT_TENANT=demo
AMP_SOLR_URL=http://solr:8983/solr
AMP_SOLR_COLLECTION=amp_objects
AMP_TIKA_URL=http://tika:9998
AMP_HOP_URL=http://hop:8080

# Dedicated archive service (no protocol gateway)
AMP_WORKER_ENABLED=true
AMP_MAX_UPLOAD_BYTES=1073741824
# Non-demo use requires an operator API key or server-defined bearer identities.
# Keys in this JSON are SHA-256 hashes of bearer tokens; groups/roles are trusted server configuration.
AMP_IDENTITIES_JSON={}
# Optional read-only Hop runner; qualify the servlet against the installed Hop release.
AMP_HOP_PIPELINES_JSON={}
AMP_HOP_SHARED_ROOT=/data/workbench
AMP_HOP_USERNAME=
AMP_HOP_PASSWORD=
